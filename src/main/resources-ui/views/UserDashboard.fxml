<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.location.voitures.controllers.UserDashboardController">
   <top>
      <HBox alignment="CENTER_RIGHT" spacing="20.0" style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-padding: 20;">
         <Label style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;" text="🚗 Location de Voitures" />
         <Region HBox.hgrow="ALWAYS" />
         <Button fx:id="adminButton" onAction="#handleAdmin" style="-fx-background-color: #ff6b6b; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 25; -fx-padding: 10 20;" text="⚙️ Admin" />
      </HBox>
   </top>
   
   <center>
      <ScrollPane fitToWidth="true" style="-fx-background: #f8f9fa; -fx-background-color: #f8f9fa;">
         <VBox fx:id="voituresContainer" alignment="CENTER" spacing="30.0" style="-fx-background-color: #f8f9fa; -fx-padding: 30;">
            
            <!-- Voiture 1 -->
            <HBox alignment="CENTER" spacing="20.0">
               <VBox alignment="CENTER" maxWidth="280.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5); -fx-padding: 20;">
                  <ImageView fitHeight="120.0" fitWidth="200.0" preserveRatio="true">
                     <image>
                        <Image url="@/images/clio.jpg" />
                     </image>
                  </ImageView>
                  <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Renault Clio" />
                  <Label style="-fx-background-color: #56ab2f; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 5 15; -fx-background-radius: 20; -fx-font-size: 12px;" text="DISPONIBLE" />
                  <Label style="-fx-font-size: 18px; -fx-text-fill: #667eea; -fx-font-weight: bold;" text="35€/jour" />
                  <Button onAction="#handleReserver" prefWidth="200.0" style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 25; -fx-padding: 12 20;" text="📅 Réserver" />
               </VBox>
               
               <VBox alignment="CENTER" maxWidth="280.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5); -fx-padding: 20;">
                  <ImageView fitHeight="120.0" fitWidth="200.0" preserveRatio="true">
                     <image>
                        <Image url="@/images/308.jpg" />
                     </image>
                  </ImageView>
                  <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Peugeot 308" />
                  <Label style="-fx-background-color: #56ab2f; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 5 15; -fx-background-radius: 20; -fx-font-size: 12px;" text="DISPONIBLE" />
                  <Label style="-fx-font-size: 18px; -fx-text-fill: #667eea; -fx-font-weight: bold;" text="45€/jour" />
                  <Button onAction="#handleReserver" prefWidth="200.0" style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 25; -fx-padding: 12 20;" text="📅 Réserver" />
               </VBox>
            </HBox>
            
            <!-- Voiture 2 -->
            <HBox alignment="CENTER" spacing="20.0">
               <VBox alignment="CENTER" maxWidth="280.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5); -fx-padding: 20;">
                  <ImageView fitHeight="120.0" fitWidth="200.0" preserveRatio="true">
                     <image>
                        <Image url="@/images/bmw.jpg" />
                     </image>
                  </ImageView>
                  <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="BMW Série 3" />
                  <Label style="-fx-background-color: #ff416c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 5 15; -fx-background-radius: 20; -fx-font-size: 12px;" text="NON DISPONIBLE" />
                  <Label style="-fx-font-size: 18px; -fx-text-fill: #667eea; -fx-font-weight: bold;" text="80€/jour" />
                  <Button disable="true" prefWidth="200.0" style="-fx-background-color: #bdc3c7; -fx-text-fill: #7f8c8d; -fx-font-size: 14px; -fx-background-radius: 25; -fx-padding: 12 20;" text="❌ Indisponible" />
               </VBox>
               
               <VBox alignment="CENTER" maxWidth="280.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 5); -fx-padding: 20;">
                  <ImageView fitHeight="120.0" fitWidth="200.0" preserveRatio="true">
                     <image>
                        <Image url="@/images/audi.jpg" />
                     </image>
                  </ImageView>
                  <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Audi A4" />
                  <Label style="-fx-background-color: #56ab2f; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 5 15; -fx-background-radius: 20; -fx-font-size: 12px;" text="DISPONIBLE" />
                  <Label style="-fx-font-size: 18px; -fx-text-fill: #667eea; -fx-font-weight: bold;" text="75€/jour" />
                  <Button onAction="#handleReserver" prefWidth="200.0" style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 25; -fx-padding: 12 20;" text="📅 Réserver" />
               </VBox>
            </HBox>
            
         </VBox>
      </ScrollPane>
   </center>
</BorderPane>